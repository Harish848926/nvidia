# Plant Disease Detection & RAG Knowledge Configuration
# Optimized for NVIDIA DGX Server and Local Environments

# Compute device: cuda or cpu (auto-detected if blank)
DEVICE=auto

# File and Directory Paths
MODEL_PATH=model/plant_model.pth
DATA_PATH=data/plantvillage
DOCUMENTS_PATH=documents

# Web App Configuration
APP_PORT=8501
APP_HOST=0.0.0.0

# NVIDIA Cloud & NGC NIM API
NVIDIA_API_KEY="your_nvidia_api_key_here"
NGC_API_KEY="your_ngc_api_key_here"

# Neo4j Knowledge Graph Configuration (GraphRAG)
NEO4J_URI="bolt://localhost:7687"
NEO4J_USER="neo4j"
NEO4J_PASSWORD="your_neo4j_password_here"
